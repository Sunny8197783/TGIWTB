    "벚꽃 골짜기": { "wind": 0.5, "birds": 0.8, "crickets": 0.5, "lake": 0.3 },
    "하나미 마을": { "wind": 0.3, "birds": 0.6, "crickets": 0.5, "lake": 0.4 },
    "꽃 들판":     { "wind": 0.8, "birds": 0.7, "crickets": 0.8 },
    "꽃 마을":     { "wind": 0.5, "birds": 0.6, "crickets": 0.6 },
    "등대 곶":     { "wind": 1.0, "birds": 0.1, "crickets": 0.2, "waves": 0.9 },
    "거울 호수":   { "wind": 0.3, "birds": 0.7, "crickets": 0.8, "lake": 0.9 },
    "단풍 협곡":   { "wind": 0.7, "birds": 0.5, "crickets": 0.5, "lake": 0.3 },
