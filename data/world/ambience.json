{
  // 환경음 (M4, Core/Ambience). 소리는 tools/synth_ambience.py 가 만든다.
  // layers: 층마다 고리 소리와 최대 음량(dB). time 이 day 면 밤에 줄고, night 면 밤에만 난다.
  "layers": {
    "wind":      { "file": "res://audio/ambience/wind.wav",      "db": -16 },
    "birds":     { "file": "res://audio/ambience/birds.wav",     "db": -18, "time": "day" },
    "crickets":  { "file": "res://audio/ambience/crickets.wav",  "db": -26, "time": "night" },
    "waves":     { "file": "res://audio/ambience/waves.wav",     "db": -13 },
    "lake":      { "file": "res://audio/ambience/lake.wav",      "db": -17 },
    "waterfall": { "file": "res://audio/ambience/waterfall.wav", "db": -11 }
  },
  // 지역마다 층 세기 0~1 (지역 밖은 default). 이름은 지도 meta 의 zones 와 같아야 한다
  "default": { "wind": 0.5, "birds": 0.5, "crickets": 0.6 },
  "zones": {
