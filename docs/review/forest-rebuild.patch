-            BuildingKind shop = Any(large);
-            _shopCount.TryGetValue(shop.Texture, out int used);
-            if (used < MaxPerShop)
-            {
-                _shopCount[shop.Texture] = used + 1;
-                return shop;
-            }
-        }
-        return shop_fallback();
