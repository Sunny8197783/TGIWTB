+    private void Scan(Node parent)
+    {
+        foreach (var child in parent.GetChildren())
+        {
+            if (child == this) continue;
+            if (child is Node2D source && (source is CharacterBody2D or Npc or Arrow or SkillBolt)) Track(source);
+            Scan(child);
+        }
+    }
