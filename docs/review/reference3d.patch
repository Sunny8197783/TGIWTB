+    public void Ring(Vector2 point, float radius, Color color, float seconds, float angle = 0f, float arc = Mathf.Tau)
+    {
+        var st = new SurfaceTool(); st.Begin(Mesh.PrimitiveType.Triangles);
+        float outer = Mathf.Max(.12f, radius / ReferenceTerrain3D.Unit), inner = outer * .78f;
+        for (int i = 0; i < 32; i++)
+        {
+            float a = angle - arc * .5f + arc * i / 32f, b = a + arc / 32f;
+            Vector3 P(float theta, float r) => new(Mathf.Cos(theta) * r, 0f, Mathf.Sin(theta) * r);
+            foreach (var v in new[] { P(a, inner), P(b, inner), P(a, outer), P(a, outer), P(b, inner), P(b, outer) }) st.AddVertex(v);
+        }
+        var material = new StandardMaterial3D { AlbedoColor = color, ShadingMode = BaseMaterial3D.ShadingModeEnum.Unshaded,
+            Transparency = BaseMaterial3D.TransparencyEnum.Alpha, CullMode = BaseMaterial3D.CullModeEnum.Disabled };
+        var fx = new MeshInstance3D { Mesh = st.Commit(), MaterialOverride = material,
+            Position = ReferenceTerrain3D.Ground(point) + Vector3.Up * .3f, CastShadow = GeometryInstance3D.ShadowCastingSetting.Off };
+        st.Dispose(); AddChild(fx);
+        var tween = CreateTween().SetParallel();
+        tween.TweenProperty(fx, "scale", new Vector3(1.22f, 1f, 1.22f), seconds);
+        tween.TweenProperty(material, "albedo_color:a", 0f, seconds);
+        tween.Chain().TweenCallback(Callable.From(fx.QueueFree));
+    }
