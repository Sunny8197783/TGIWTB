; PixelMmo — Godot 4 (.NET) project configuration
;
; 입력 액션은 project.godot 이 아니라 scripts/Runtime/InputSetup.cs 에서
; 코드로 등록한다. (§C-8 키맵을 한 곳에서 읽고 고치기 위함)

config_version=5

[application]

config/name="PixelMmo"
config/description="P1 — 전투 프로토타입"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[autoload]

GameDb="*res://scripts/Data/GameDatabase.cs"
SaveSystem="*res://scripts/Runtime/SaveSystem.cs"
InputSetup="*res://scripts/Runtime/InputSetup.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="PixelMmo"

[editor]

export/convert_text_resources_to_binary=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
